{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "outDir": ".out",
    "rootDir": "../..",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "types": []
  },
  "include": [
    "jest-globals.d.ts",
    "../../src/domain/**/*.ts",
    "../../src/utils/**/*.ts",
    "../../src/security/**/*.ts",
    "../../src/config/parseConfig.ts",
    "../../src/config/__tests__/*.ts",
    "../../src/services/captcha/**/*.ts"
  ]
}
